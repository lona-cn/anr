#version 430 core
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Weights { float weights[]; };
layout(std430, binding = 1) readonly buffer StateIn { float state_in[]; };
layout(std430, binding = 2) buffer StateOut { float state_out[]; };
layout(std430, binding = 3) buffer Scratch { float scratch[]; };
uniform uint p[32];
// p[0]=inverse, p[2]=source, p[3]=destination, p[4]=complex twiddles.
shared vec2 a[960];
shared vec2 b[960];
const uint radix[5] = uint[5](5u, 3u, 4u, 4u, 4u);
vec2 product(vec2 x, vec2 y) {
    return vec2(x.x*y.x-x.y*y.y, x.x*y.y+x.y*y.x);
}
void main() {
    uint lane = gl_LocalInvocationID.x;
    for (uint i=lane; i<960u; i+=128u) {
        uint index=i, stride=960u, source=0u;
        for (uint stage=0u; stage<5u; ++stage) {
            stride/=radix[stage];
            source+=(index%radix[stage])*stride;
            index/=radix[stage];
        }
        if (p[0]==0u) {
            a[i]=vec2(scratch[p[2]+source],0.0);
        } else {
            uint frequency=source<=480u ? source : 960u-source;
            vec2 value=vec2(scratch[p[2]+2u*frequency],scratch[p[2]+2u*frequency+1u]);
            // A real inverse ignores imaginary DC and Nyquist components.
            if (frequency==0u || frequency==480u) value.y=0.0;
            if (source>480u) value.y=-value.y;
            a[i]=value;
        }
    }
    memoryBarrierShared(); barrier();
    uint previous=1u;
    for (uint stage=0u; stage<5u; ++stage) {
        uint r=radix[stage], extent=previous*r;
        for (uint i=lane; i<960u; i+=128u) {
            uint base=(i/extent)*extent, k=i%previous, output_digit=(i%extent)/previous;
            vec2 sum=vec2(0.0);
            for (uint q=0u; q<r; ++q) {
                uint phase=(q*k*(960u/extent)+q*output_digit*(960u/r))%960u;
                vec2 twiddle=vec2(weights[p[4]+2u*phase],weights[p[4]+2u*phase+1u]);
                if (p[0]!=0u) twiddle.y=-twiddle.y;
                uint source=base+k+q*previous;
                vec2 value=(stage%2u)==0u ? a[source] : b[source];
                sum+=product(value,twiddle);
            }
            if ((stage%2u)==0u) b[i]=sum;
            else a[i]=sum;
        }
        memoryBarrierShared(); barrier();
        previous=extent;
    }
    if (p[0]==0u) {
        for (uint i=lane; i<481u; i+=128u) {
            vec2 value=b[i]*(1.0/960.0);
            scratch[p[3]+2u*i]=value.x;
            scratch[p[3]+2u*i+1u]=value.y;
        }
    } else {
        // Unscaled inverse cancels the graph's explicit post-IRFFT *960.
        for (uint i=lane; i<960u; i+=128u) scratch[p[3]+i]=b[i].x;
    }
}
