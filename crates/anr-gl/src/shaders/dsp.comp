#version 430 core
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Weights { float weights[]; };
layout(std430, binding = 1) readonly buffer StateIn { float state_in[]; };
layout(std430, binding = 2) buffer StateOut { float state_out[]; };
layout(std430, binding = 3) buffer Scratch { float scratch[]; };
uniform uint p[32];
// Fixed scratch/weight offsets are assigned once in dsp.rs.
shared uint nonzero_mean;
shared uint nonzero_norm;
vec2 spectrum(uint f) { return vec2(scratch[p[6]+2u*f],scratch[p[6]+2u*f+1u]); }
void features() {
    uint i=gl_LocalInvocationID.x;
    if (i==0u) { nonzero_mean=0u; nonzero_norm=0u; }
    memoryBarrierShared(); barrier();
    if (i<32u && state_in[i]!=0.0) atomicOr(nonzero_mean,1u);
    if (i<96u && state_in[32u+i]!=0.0) atomicOr(nonzero_norm,1u);
    memoryBarrierShared(); barrier();
    const float beta=0.009999990463256836;
    if (i<32u) {
        uint start=uint(weights[p[19]+i]), end=uint(weights[p[19]+32u+i]);
        float power=0.0;
        for (uint f=start; f<end; ++f) {
            vec2 z=spectrum(f);
            power+=(z.x*z.x+z.y*z.y)*weights[p[20]+f];
        }
        float energy=10.0*(log(power+1.000000013351432e-10)/2.3025851249694824);
        float old=nonzero_mean==0u ? weights[p[17]+i] : state_in[i];
        float mean=old-(old-energy)*beta;
        state_out[i]=mean;
        scratch[p[7]+i]=(energy-mean)/40.0;
    }
    if (i<96u) {
        vec2 z=spectrum(i);
        float magnitude=sqrt(z.x*z.x+z.y*z.y);
        float old=nonzero_norm==0u ? weights[p[18]+i] : state_in[32u+i];
        float norm=old-(old-magnitude)*beta;
        state_out[32u+i]=norm;
        vec2 value=z/sqrt(norm);
        scratch[p[8]+2u*i]=value.x;
        scratch[p[8]+2u*i+1u]=value.y;
    }
}
void histories(uint i) {
    if (i<96u) {
        float value=i<64u ? state_in[1088u+i+32u] : scratch[p[7]+i-64u];
        scratch[p[9]+i]=value;
        state_out[1088u+i]=value;
    }
    if (i<576u) {
        uint channel=i/288u, position=i%288u, time=position/96u, f=position%96u;
        float value=time<2u ? state_in[1184u+channel*288u+(time+1u)*96u+f]
            : scratch[p[8]+2u*f+channel];
        scratch[p[10]+i]=value;
        state_out[1184u+i]=value;
    }
    if (i<4810u) state_out[32480u+i]=i<3848u ? state_in[32480u+i+962u] : scratch[p[6]+i-3848u];
    if (i<6734u) state_out[37290u+i]=i<5772u ? state_in[37290u+i+962u] : scratch[p[6]+i-5772u];
}
void filter_spectrum(uint f) {
    uint band=uint(weights[p[21]+f]);
    vec2 wet=vec2(state_out[37290u+4u*962u+2u*f],state_out[37290u+4u*962u+2u*f+1u]);
    wet*=scratch[p[13]+band];
    if (f<96u) {
        wet=vec2(0.0);
        for (uint tap=0u; tap<5u; ++tap) {
            uint s=32480u+tap*962u+2u*f, c=p[14]+(tap*96u+f)*2u;
            vec2 z=vec2(state_out[s],state_out[s+1u]);
            vec2 coefficient=vec2(scratch[c],scratch[c+1u]);
            wet+=vec2(z.x*coefficient.x-z.y*coefficient.y,z.x*coefficient.y+z.y*coefficient.x);
        }
    }
    if (p[23]!=0u) {
        vec2 dry=vec2(state_in[32480u+2u*962u+2u*f],state_in[32480u+2u*962u+2u*f+1u]);
        float alpha=uintBitsToFloat(p[22]);
        vec2 difference=dry-wet;
        wet=alpha<0.5 ? wet+alpha*difference : dry-(1.0-alpha)*difference;
    }
    scratch[p[15]+2u*f]=wet.x;
    scratch[p[15]+2u*f+1u]=wet.y;
}
void main() {
    if (p[0]==1u) { features(); return; }
    uint i=gl_GlobalInvocationID.x;
    if (i>=p[1]) return;
    if (p[0]==0u) {
        float value=i<480u ? state_in[128u+i] : scratch[p[2]+i-480u];
        scratch[p[5]+i]=value*weights[p[4]+i];
        if (i<480u) state_out[128u+i]=scratch[p[2]+i];
    } else if (p[0]==2u) histories(i);
    else if (p[0]==3u) {
        uint channel=i/480u, time=(i/96u)%5u, f=i%96u;
        float value=time<4u ? state_in[1760u+i+96u] : scratch[p[12]+channel*96u+f];
        state_out[1760u+i]=value;
        scratch[p[11]+i]=value;
    } else if (p[0]==4u) filter_spectrum(i);
    else if (p[0]==5u) {
        scratch[p[3]+i]=scratch[p[16]+i]*weights[p[4]+i]+state_in[608u+i];
        state_out[608u+i]=scratch[p[16]+i+480u]*weights[p[4]+i+480u];
    }
}
